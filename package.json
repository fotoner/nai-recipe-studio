{
  "name": "nai-recipe-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Build NovelAI prompt recipes and manage image generation on your desktop.",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "pnpm build:mcp && pnpm bundle:runtime && electron-vite dev",
    "build": "pnpm build:icons && electron-vite build && pnpm build:mcp && pnpm audit:dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm typecheck && pnpm lint && pnpm test:coverage",
    "package:dir": "pnpm build && pnpm bundle:runtime && electron-builder --dir",
    "package": "pnpm build && pnpm bundle:runtime && electron-builder",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "build:mcp": "node scripts/build-mcp.mjs",
    "bundle:runtime": "node scripts/bundle-runtime.mjs",
    "audit:dist": "tsx scripts/release-audit.ts",
    "build:icons": "node scripts/build-icons.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "@base-ui/react": "^1.8.0",
    "@eslint/js": "^9.0.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@playwright/test": "^1.55.0",
    "@resvg/resvg-js": "2.6.2",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/vite": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "5.0.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "electron": "44.4.3",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7.0.0",
    "i18next": "26.4.2",
    "jsdom": "^30.1.0",
    "lucide-react": "^1.47.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "17.0.14",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.3.0",
    "vitest": "^5.0.1",
    "zod": "^4.6.5"
  },
  "packageManager": "pnpm@10.27.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "better-sqlite3",
      "esbuild"
    ]
  },
  "author": "fotoner",
  "license": "UNLICENSED"
}
